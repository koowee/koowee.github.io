---
import AppGuideView from '../../../views/AppGuideView.astro';
import { getApps, type AppMeta } from '../../../lib/apps.ts';
export async function getStaticPaths() {
  return (await getApps()).filter((app) => app.guide).map((app) => ({ params: { app: app.slug }, props: { app } }));
}
const { app } = Astro.props as { app: AppMeta };
---
<AppGuideView app={app} locale="fi" />
